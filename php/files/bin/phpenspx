#!/bin/sh
set -e

# Enable php-spx
if ! [ -f "$(php -r 'echo ini_get("extension_dir");')/spx.so" ]; then
    echo "php-spx is not available for PHP ${PHP_VERSION} in this image" >&2
    exit 1
fi
echo "Enabling php-spx.."
sudo phpenmod php-spx

# Stop php-fpm if running
echo "Stopping php-fpm.."
sudo killall -9 php-fpm

# Start php-fpm
echo "Starting php-fpm.."
sudo KNOT_USER=${KNOT_USER} /usr/sbin/php-fpm -D
