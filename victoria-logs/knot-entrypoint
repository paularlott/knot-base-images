#!/bin/sh
set -e

# As PID 1 the shell ignores unhandled signals, so a container stop would
# wait out the runtime's kill grace and end in SIGKILL (crash recovery for a
# database). Forward SIGTERM/SIGINT to the service (once started), let the
# syslog logger drain, and exit cleanly.
trap 'if [ -n "${service_pid:-}" ]; then kill -TERM "$service_pid" 2>/dev/null; fi; wait; exit 0' TERM INT

# Make KNOT_USER available in called scripts
export KNOT_USER=victoria-logs

# Write the variables to /etc/environment if they are defined
if [ "${KNOT_USER:-}" ]; then
  echo "KNOT_USER=$KNOT_USER" >> /etc/environment
fi
if [ "${KNOT_WILDCARD_DOMAIN:-}" ]; then
  echo "KNOT_WILDCARD_DOMAIN=$KNOT_WILDCARD_DOMAIN" >> /etc/environment
fi
if [ "${KNOT_SPACEID:-}" ]; then
  echo "KNOT_SPACEID=$KNOT_SPACEID" >> /etc/environment
fi

# If "/home/${KNOT_USER}" doesn't exist, create it
if [ ! -d "/home/${KNOT_USER}" ]; then
  mkdir -p "/home/${KNOT_USER}/.ssh"
  chmod 0700 "/home/${KNOT_USER}/.ssh"
  chown -R "${KNOT_USER}:${KNOT_USER}" "/home/${KNOT_USER}/"
fi

# If KNOT_SERVER is defined then fetch the agent and start it
if [ "${KNOT_SERVER:-}" ]; then

  # Get the host architecture, arm64 or amd64
  ARCH=$(uname -m)
  case "$ARCH" in
    'x86_64') url="knot_agent_linux_amd64";;
    'aarch64') url="knot_agent_linux_arm64";;
    *) echo >&2 "error: unsupported architecture: '$ARCH'"; exit 1 ;;
  esac

  echo "Fetching agent binary for $ARCH"

  # Download the application from the server
  resolve_opt=""
  if [ -n "${KNOT_SERVER_RESOLVE:-}" ]; then resolve_opt="--resolve ${KNOT_SERVER_RESOLVE}"; fi
  if ! curl -sSLk $resolve_opt ${KNOT_SERVER}/agents/$url.zip | funzip > /usr/local/bin/knot; then
    echo >&2 "error: failed to fetch agent binary"
    exit 1
  fi
  chmod +x /usr/local/bin/knot

  # Allow the agent to bind to low ports
  setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/knot

  echo "Starting knot agent..."
  gosu ${KNOT_USER} /usr/local/bin/knot agent start 2>&1 &

  gosu ${KNOT_USER} /usr/local/bin/knot agent wait-for-start >/dev/null 2>&1 || echo >&2 "Note: agent readiness cannot be verified."
fi

# If KNOT_SYSLOG_PORT is not defined or not 0 then route to agents syslogd port
if [ -x /usr/local/bin/knot ] && [ "${KNOT_SYSLOG_PORT:-1}" -ne 0 ]; then
  echo "Forwarding logs to knot agent syslogd port ${KNOT_SYSLOG_PORT:-1514}"
  mkdir -p /etc/rsyslog.d
  echo "*.* @127.0.0.1:${KNOT_SYSLOG_PORT:-1514}" > /etc/rsyslog.d/99-knotagent.conf
  echo "stop" >> /etc/rsyslog.d/99-knotagent.conf

  # Only start rsyslogd when forwarding to the knot agent, and forward-only so
  # that nothing is written to local log files, which would never be rotated
  echo "Starting rsyslogd.."
  rsyslogd
fi

# Make KNOT_USER available in called scripts
export KNOT_USER

# If the folder /etc/knot-startup.d/ exists then run all scripts in it
if [ -d /etc/knot-startup.d/ ]; then
  for f in /etc/knot-startup.d/*; do
    if [ -f "$f" ]; then
      logger -p local0.info "Running startup script $f"
      bash $f
    fi
  done
fi

# If the folder /home/${KNOT_USER}/.knot-startup.d/ exists then run all scripts in it
if [ -d /home/${KNOT_USER}/.knot-startup.d/ ]; then
  for f in /home/${KNOT_USER}/.knot-startup.d/*; do
    if [ -f "$f" ]; then
      logger -p local0.info "Running user startup script $f"
      gosu ${KNOT_USER} bash $f
    fi
  done
fi

# Inject retention from VICTORIA_LOGS_RETENTION_PERIOD (default 30d, set in the
# Dockerfile ENV) so it can be overridden via an env var without editing the
# command — e.g. set VICTORIA_LOGS_RETENTION_PERIOD=7d in the space/template.
set -- -retentionPeriod "${VICTORIA_LOGS_RETENTION_PERIOD:-30d}" "$@"

# If auth credentials are provided, put vmauth (HTTP basic auth proxy) in front
# of VictoriaLogs. vmauth listens on :9428 and proxies to VictoriaLogs on the
# loopback (127.0.0.1:8428). Without credentials, VictoriaLogs is exposed
# directly on :9428 with no auth.
if [ -n "${VICTORIA_LOGS_USERNAME:-}" ] && [ -n "${VICTORIA_LOGS_PASSWORD:-}" ]; then
  # Build the vmauth config from env vars. Values are escaped for YAML
  # single-quoted strings (a single quote is doubled) so arbitrary secrets,
  # including those with special characters, are safe.
  vl_user=$(printf '%s' "${VICTORIA_LOGS_USERNAME}" | sed "s/'/''/g")
  vl_pass=$(printf '%s' "${VICTORIA_LOGS_PASSWORD}" | sed "s/'/''/g")
  mkdir -p /etc/vmauth
  cat > /etc/vmauth/auth.yml <<EOF
users:
  - username: '${vl_user}'
    password: '${vl_pass}'
    url_prefix:
      - http://127.0.0.1:8428
EOF
  chown ${KNOT_USER}:${KNOT_USER} /etc/vmauth/auth.yml
  chmod 600 /etc/vmauth/auth.yml

  echo "Starting vmauth (basic auth) on :9428 -> 127.0.0.1:8428..."
  gosu ${KNOT_USER} /usr/local/bin/vmauth \
    -auth.config=/etc/vmauth/auth.yml \
    -httpListenAddr=:9428 2>&1 | logger -t 'vmauth' -p daemon.info &

  # VictoriaLogs listens on the loopback only; vmauth exposes :9428.
  set -- -httpListenAddr=127.0.0.1:8428 "$@"
else
  echo "VICTORIA_LOGS_USERNAME/VICTORIA_LOGS_PASSWORD not set - running without auth on :9428"
  set -- -httpListenAddr=:9428 "$@"
fi

# Run victoria-logs as the victoria-logs user, piping output to syslog (it only
# supports stderr/stdout logging) so the knot agent captures the logs. The
# fifo keeps the logger draining while victoria-logs runs in the background —
# its pid feeds the SIGTERM trap above (an exec-pipeline would leave this
# shell as PID 1 ignoring the stop signal).
LOGFIFO=/tmp/knot-service-logs.$$
mkfifo "$LOGFIFO"
logger -t 'victoria-logs' -p daemon.info < "$LOGFIFO" &
gosu ${KNOT_USER} /usr/local/bin/victoria-logs "$@" > "$LOGFIFO" 2>&1 &
service_pid=$!
wait $service_pid
