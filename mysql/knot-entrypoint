#!/bin/sh
set -e

# As PID 1 the shell ignores unhandled signals, so a container stop would
# wait out the runtime's kill grace and end in SIGKILL (crash recovery for a
# database). Forward SIGTERM/SIGINT to the service (once started), let the
# syslog logger drain, and exit cleanly.
trap 'if [ -n "${service_pid:-}" ]; then kill -TERM "$service_pid" 2>/dev/null; fi; wait; exit 0' TERM INT

# Make KNOT_USER available in called scripts
export KNOT_USER=mysql

# Write the variables to /etc/environment if they are defined
if [ "${KNOT_USER:-}" ]; then
  echo "KNOT_USER=$KNOT_USER" >> /etc/environment
fi
if [ "${KNOT_WILDCARD_DOMAIN:-}" ]; then
  echo "KNOT_WILDCARD_DOMAIN=$KNOT_WILDCARD_DOMAIN" >> /etc/environment
fi
if [ "${KNOT_SPACEID:-}" ]; then
  echo "KNOT_SPACEID=$KNOT_SPACEID" >> /etc/environment
fi

# If KNOT_SERVER is defined then fetch the agent and start it
if [ "${KNOT_SERVER:-}" ]; then

  # Get the host architecture, arm64 or amd64
  ARCH=$(uname -m)
  case "$ARCH" in
    'x86_64') url="knot_agent_linux_amd64";;
    'aarch64') url="knot_agent_linux_arm64";;
    *) echo >&2 "error: unsupported architecture: '$ARCH'"; exit 1 ;;
  esac

  echo "Fetching agent binary for $ARCH"

  # Download the application from the server
  resolve_opt=""
  if [ -n "${KNOT_SERVER_RESOLVE:-}" ]; then resolve_opt="--resolve ${KNOT_SERVER_RESOLVE}"; fi
  if ! curl -sSLk $resolve_opt ${KNOT_SERVER}/agents/$url.zip | funzip > /usr/local/bin/knot; then
    echo >&2 "error: failed to fetch agent binary"
    exit 1
  fi
  chmod +x /usr/local/bin/knot

  # Allow the agent to bind to low ports
  setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/knot

  echo "Starting knot agent..."
  gosu ${KNOT_USER} /usr/local/bin/knot agent start 2>&1 &

  gosu ${KNOT_USER} /usr/local/bin/knot agent wait-for-start >/dev/null 2>&1 || echo >&2 "Note: agent readiness cannot be verified."
fi

# If KNOT_SYSLOG_PORT is not defined or not 0 then route to agents syslogd port
if [ -x /usr/local/bin/knot ] && [ "${KNOT_SYSLOG_PORT:-1}" -ne 0 ]; then
  echo "Forwarding logs to knot agent syslogd port ${KNOT_SYSLOG_PORT:-514}"
  echo "*.* @127.0.0.1:${KNOT_SYSLOG_PORT:-514}" > /etc/rsyslog.d/99-knotagent.conf
fi

echo "Starting rsyslogd.."
rsyslogd

# Setup sudoers
echo "${KNOT_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${KNOT_USER}
chmod 0440 /etc/sudoers.d/${KNOT_USER}

# If the folder /etc/knot-startup.d/ exists then run all scripts in it
if [ -d /etc/knot-startup.d/ ]; then
  for f in /etc/knot-startup.d/*; do
    if [ -f "$f" ]; then
      logger -p local0.info "Running startup script $f"
      bash $f
    fi
  done
fi

# If the folder /home/${KNOT_USER}/.knot-startup.d/ exists then run all scripts in it
if [ -d /home/${KNOT_USER}/.knot-startup.d/ ]; then
  for f in /home/${KNOT_USER}/.knot-startup.d/*; do
    if [ -f "$f" ]; then
      logger -p local0.info "Running user startup script $f"
      gosu ${KNOT_USER} bash $f
    fi
  done
fi

if [ -n "${MYSQL_ENCRYPTION_KEY:-}" ]; then
  KEYRING_DIR="/var/lib/mysql-keyring"
  KEYRING_FILE="$KEYRING_DIR/keyring"
  ENC_KEYRING="/var/lib/mysql/.mysql-keyring.enc"
  PASSDIR="/run/mysql-encryption"
  PASSFILE="$PASSDIR/pass"
  MANIFEST="/usr/sbin/mysqld.my"
  ENCCFG="/etc/mysql/conf.d/zz-knot-encryption.cnf"

  mkdir -p "$KEYRING_DIR" "$PASSDIR"
  chown mysql:mysql "$KEYRING_DIR"
  printf '%s' "$MYSQL_ENCRYPTION_KEY" > "$PASSFILE"
  chmod 0400 "$PASSFILE"

  printf '{\n  "components": "file://component_keyring_file"\n}\n' > "$MANIFEST"
  chmod 644 "$MANIFEST"

  if [ -f "$ENC_KEYRING" ]; then
    if ! openssl enc -d -aes-256-cbc -md sha256 -salt -pass file:"$PASSFILE" \
         -in "$ENC_KEYRING" -out "$KEYRING_FILE"; then
      echo >&2 "error: MYSQL_ENCRYPTION_KEY does not match the keyring used to encrypt this data directory"
      exit 1
    fi
  else
    : > "$KEYRING_FILE"
  fi
  chown mysql:mysql "$KEYRING_FILE"
  chmod 660 "$KEYRING_FILE"

  cat > "$ENCCFG" <<EOF
# Managed by knot-entrypoint when MYSQL_ENCRYPTION_KEY is set - do not edit.
[mysqld]
default_table_encryption=ON
innodb_redo_log_encrypt=ON
innodb_undo_log_encrypt=ON
binlog_encryption=ON
EOF

  logger -p local0.info "MySQL data-at-rest encryption enabled (component_keyring_file)"

  (
    set +e
    _last=""
    while true; do
      if [ -s "$KEYRING_FILE" ]; then
        _sz=$(wc -c < "$KEYRING_FILE" 2>/dev/null || echo 0)
        if [ "$_sz" != "$_last" ]; then
          _tmp="${ENC_KEYRING}.tmp"
          if openssl enc -aes-256-cbc -md sha256 -salt -pass file:"$PASSFILE" \
               -in "$KEYRING_FILE" -out "$_tmp" 2>/dev/null; then
            mv "$_tmp" "$ENC_KEYRING"
            _last="$_sz"
          fi
        fi
      fi
      sleep 10
    done
  ) &
fi

# Run the old entrypoint
if [ "$@" = 'mysqld' ]; then
  # The fifo keeps the logger draining while the database runs in the
  # background; its pid feeds the SIGTERM trap above, so a stop is a clean
  # shutdown instead of the SIGKILL an exec-pipeline would end in.
  LOGFIFO=/tmp/knot-service-logs.$$
  mkfifo "$LOGFIFO"
  logger -t 'mysqld' -p daemon.error < "$LOGFIFO" &
  /usr/local/bin/docker-entrypoint.sh "$@" > "$LOGFIFO" 2>&1 &
  service_pid=$!
  wait $service_pid
else
  exec /usr/local/bin/docker-entrypoint.sh "$@"
fi
