#!/bin/bash
# zsh runs its new-user wizard when the home has no zsh startup files, which
# stalls the first zsh terminal on a prompt. An empty ~/.zshrc stops it.
# History settings live in /etc/zsh/zshrc.

home="/home/${KNOT_USER}"
[ -d "$home" ] || exit 0

for f in .zshenv .zprofile .zshrc .zlogin; do
  [ -e "$home/$f" ] && exit 0
done

echo "# zsh history is configured in /etc/zsh/zshrc; add your own settings here" > "$home/.zshrc"
chown "${KNOT_USER}:${KNOT_USER}" "$home/.zshrc"
